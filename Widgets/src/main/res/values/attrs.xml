<?xml version="1.0" encoding="utf-8"?>
<resources>
    <item name="banner_pager" type="id" />
    <item name="banner_indicator" type="id" />

    <!--自定义View xml属性-->

    <attr name="cyclic" format="boolean|reference" />
    <attr name="radius" format="dimension|reference" />
    <attr name="indicatorWidth" format="dimension">
        <enum name="match_parent" value="-1" />
        <enum name="wrap_content" value="-2" />
    </attr>

    <attr name="indicatorHeight" format="dimension">
        <enum name="match_parent" value="-1" />
        <enum name="wrap_content" value="-2" />
    </attr>
    <attr name="indicatorBackgroundColor" format="color|reference" />
    <attr name="indicatorSelectWidth" format="dimension|reference" />
    <attr name="indicatorSelectHeight" format="dimension|reference" />
    <attr name="indicatorNormalWidth" format="dimension|reference" />
    <attr name="indicatorNormalHeight" format="dimension|reference" />
    <attr name="indicatorSelectRadius" format="dimension|reference" />
    <attr name="indicatorNormalRadius" format="dimension|reference" />
    <attr name="indicatorSpace" format="dimension|reference" />
    <attr name="indicatorSelectColor" format="color|reference" />
    <attr name="indicatorNormalColor" format="color|reference" />
    <attr name="indicatorGravity">
        <flag name="top" value="0x30" />
        <flag name="bottom" value="0x50" />
        <flag name="left" value="0x03" />
        <flag name="right" value="0x05" />
        <flag name="center_vertical" value="0x10" />
        <flag name="fill_vertical" value="0x70" />
        <flag name="center_horizontal" value="0x01" />
        <flag name="fill_horizontal" value="0x07" />
        <flag name="center" value="0x11" />
        <flag name="fill" value="0x77" />
        <flag name="clip_vertical" value="0x80" />
        <flag name="clip_horizontal" value="0x08" />
        <flag name="start" value="0x00800003" />
        <flag name="end" value="0x00800005" />
    </attr>
    <attr name="indicatorOrientation">
        <enum name="horizontal" value="0" />
        <enum name="vertical" value="1" />
    </attr>
    <attr name="indicatorMode" format="enum">
        <enum name="normal" value="0" />
        <enum name="smooth" value="2" />
        <enum name="worm" value="3" />
        <enum name="scale" value="4" />
        <enum name="color" value="5" />
    </attr>

    <attr name="indicatorStyle" format="enum">
        <enum name="circle" value="0" />
        <enum name="dash" value="2" />
        <enum name="round_rect" value="4" />
    </attr>

    <attr name="indicatorVisibility">
        <enum name="visible" value="0" />
        <enum name="invisible" value="1" />
        <enum name="gone" value="2" />
    </attr>

    <declare-styleable name="ShimmerLayout">
        <attr name="shimmer_color" format="color|reference" />
        <attr name="shimmer_animation_duration" format="integer|reference" />
        <attr name="shimmer_auto_start" format="boolean|reference" />
        <attr name="shimmer_angle" format="integer|reference" />
        <attr name="shimmer_mask_width" format="fraction|reference" />
        <attr name="shimmer_gradient_width" format="fraction|reference" />
        <attr name="shimmer_reverse_animation" format="boolean|reference" />
    </declare-styleable>

    <declare-styleable name="SquareImageView">
        <attr name="byWidth" format="boolean|reference" />
        <attr name="ratio" format="fraction|reference" />
    </declare-styleable>

    <declare-styleable name="RoundImageView">
        <attr name="android:scaleType" />
        <attr name="round_radius" format="dimension" />
        <attr name="round_radius_top_left" format="dimension" />
        <attr name="round_radius_top_right" format="dimension" />
        <attr name="round_radius_bottom_left" format="dimension" />
        <attr name="round_radius_bottom_right" format="dimension" />
        <attr name="round_border_width" format="dimension" />
        <attr name="round_border_color" format="color|reference" />
        <attr name="round_mutate_background" format="boolean" />
        <attr name="round_oval" format="boolean" />
        <attr name="round_filter" format="integer" />
        <attr name="round_tile_mode" format="integer">
            <enum name="clamp" value="0" />
            <enum name="repeat" value="1" />
            <enum name="mirror" value="2" />
        </attr>
        <attr name="round_tile_mode_x" format="integer">
            <enum name="clamp" value="0" />
            <enum name="repeat" value="1" />
            <enum name="mirror" value="2" />
        </attr>
        <attr name="round_tile_mode_y" format="integer">
            <enum name="clamp" value="0" />
            <enum name="repeat" value="1" />
            <enum name="mirror" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="MotionImageView">
        <attr name="motion_type">
            <enum name="grey" value="0" />
            <enum name="scale" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="WheelView">
        <!--文字大小-->
        <attr name="wheel_textSize" format="dimension|reference" />
        <!--是否自适应文字大小以完全显示过长的文字-->
        <attr name="wheel_autoSizeText" format="boolean|reference" />
        <!--自适应文字大小时最小缩放字体大小-->
        <attr name="wheel_textSizeMin" format="dimension|reference" />
        <!--文字对齐方式-->
        <attr name="wheel_textAlign" format="enum">
            <enum name="left" value="0" />
            <enum name="center" value="1" />
            <enum name="right" value="2" />
        </attr>
        <!--文本距离padding的外边距-->
        <attr name="wheel_textPadding" format="dimension|reference" />
        <attr name="wheel_textPaddingLeft" format="dimension|reference" />
        <attr name="wheel_textPaddingRight" format="dimension|reference" />
        <attr name="android:gravity" />
        <!--左右附加文本相关-->
        <attr name="wheel_leftText" format="string|reference" />
        <attr name="wheel_leftTextSize" format="dimension" />
        <attr name="wheel_leftTextColor" format="color" />
        <attr name="wheel_leftTextMarginRight" format="dimension" />
        <attr name="wheel_leftTextGravity" format="enum">
            <enum name="center" value="0x11" />
            <enum name="top" value="0x30" />
            <enum name="bottom" value="0x50" />
        </attr>
        <attr name="wheel_rightText" format="string|reference" />
        <attr name="wheel_rightTextSize" format="dimension|reference" />
        <attr name="wheel_rightTextMarginLeft" format="dimension|reference" />
        <attr name="wheel_rightTextColor" format="color|reference" />
        <attr name="wheel_rightTextGravity" format="enum">
            <enum name="center" value="17" />
            <enum name="top" value="48" />
            <enum name="bottom" value="80" />
        </attr>
        <!--左右附加文本相关-->

        <!--未选中文字颜色-->
        <attr name="wheel_normalTextColor" format="color|reference" />
        <!--被选中的文字颜色-->
        <attr name="wheel_selectedTextColor" format="color|reference" />
        <!--行间距-->
        <attr name="wheel_lineSpacing" format="dimension|reference" />

        <!--可见item数-->
        <attr name="wheel_visibleItems" format="integer|reference" />
        <!--当前选中下标-->
        <attr name="wheel_selected" format="integer|reference" />
        <!--最大选中下标-->
        <attr name="wheel_selectedMax" format="integer|reference" />
        <!--最小选中下标-->
        <attr name="wheel_selectedMin" format="integer|reference" />
        <!--是否循环滚动-->
        <attr name="wheel_cyclic" format="boolean" />

        <!--是否显示分割线-->
        <attr name="wheel_showDivider" format="boolean" />
        <!--分割线类型-->
        <attr name="wheel_dividerType" format="enum">
            <enum name="fill" value="0" />
            <enum name="wrap" value="1" />
            <enum name="wrap_all" value="2" />
        </attr>
        <!--分割线颜色-->
        <attr name="wheel_dividerColor" format="color" />
        <!--分割线高度-->
        <attr name="wheel_dividerHeight" format="dimension" />
        <!--wrap类型下分割线内边距-->
        <attr name="wheel_dividerPadding" format="dimension" />


        <!--是否是弯曲（3D）效果-->
        <attr name="wheel_curved" format="boolean" />
        <!--弯曲（3D）效果左右圆弧偏移效果方向 可向指定方向偏移-->
        <attr name="wheel_curvedArcDirection" format="enum">
            <enum name="left" value="0" />
            <enum name="center" value="1" />
            <enum name="right" value="2" />
        </attr>
        <!--弯曲（3D）效果左右圆弧偏移效果方向系数 偏移系数-->
        <attr name="wheel_curvedArcDirectionFactor" format="float" />
        <!--选中后折射的偏移(弯曲（3D）效果和普通效果都适用) 与字体大小的比值，1为不偏移 越小偏移越明显-->
        <attr name="wheel_refractRatio" format="float" />

        <!--是否绘制选中区域-->
        <attr name="wheel_isShowCurtain" format="boolean" />
        <!--选中区域颜色-->
        <attr name="wheel_curtainColor" format="color" />
        <!--选中区域/分割线上下偏移，通过移动分割线上下限制的位置来实现扩大/缩小显示区域-->
        <attr name="wheel_dividerOffsetY" format="dimension" />
    </declare-styleable>

    <declare-styleable name="BannerView">
        <attr name="cyclic" />
        <attr name="radius" />
        <attr name="cyclicCount" format="integer|reference" />
        <attr name="interval" format="integer|reference" />
        <attr name="autoPlay" format="boolean|reference" />

        <attr name="indicatorStyle" />
        <attr name="indicatorMode" />
        <attr name="indicatorWidth" />
        <attr name="indicatorHeight" />
        <attr name="indicatorSelectRadius" />
        <attr name="indicatorNormalRadius" />
        <attr name="indicatorSelectWidth" />
        <attr name="indicatorSelectHeight" />
        <attr name="indicatorNormalWidth" />
        <attr name="indicatorNormalHeight" />
        <attr name="indicatorSelectColor" />
        <attr name="indicatorNormalColor" />
        <attr name="indicatorSpace" />
        <attr name="indicatorGravity" />
        <attr name="indicatorVisibility" />
        <attr name="indicatorOrientation" />
        <attr name="indicatorBackgroundColor" />

        <attr name="limit" format="integer|reference" />
        <attr name="disallowInterceptTouchEvent" format="boolean|reference" />
        <attr name="android:clipChildren" />
        <attr name="android:orientation" />
        <attr name="android:gravity" />
    </declare-styleable>

    <declare-styleable name="IndicatorView">
        <attr name="indicatorStyle" />
        <attr name="indicatorMode" />
        <attr name="indicatorSelectWidth" />
        <attr name="indicatorSelectHeight" />
        <attr name="indicatorNormalWidth" />
        <attr name="indicatorNormalHeight" />
        <attr name="indicatorSelectRadius" />
        <attr name="indicatorNormalRadius" />
        <attr name="indicatorSelectColor" />
        <attr name="indicatorNormalColor" />
        <attr name="indicatorSpace" />
        <attr name="android:gravity" />
        <attr name="android:orientation" />
        <attr name="android:visibility" />
    </declare-styleable>
    <declare-styleable name="BannerViewPager">
        <attr name="bvp_interval" format="integer" />
        <attr name="bvp_scroll_duration" format="integer" />
        <attr name="bvp_can_loop" format="boolean" />
        <attr name="bvp_auto_play" format="boolean" />
        <attr name="bvp_round_corner" format="dimension" />
        <attr name="bvp_page_margin" format="dimension" />
        <attr name="bvp_reveal_width" format="dimension" />
        <attr name="indicatorStyle" />
        <attr name="indicatorMode" />
        <attr name="indicatorWidth" />
        <attr name="indicatorHeight" />
        <attr name="indicatorSelectWidth" />
        <attr name="indicatorSelectHeight" />
        <attr name="indicatorNormalWidth" />
        <attr name="indicatorNormalHeight" />
        <attr name="indicatorSelectRadius" />
        <attr name="indicatorNormalRadius" />
        <attr name="indicatorSelectColor" />
        <attr name="indicatorNormalColor" />
        <attr name="indicatorSpace" />
        <attr name="indicatorGravity" />
        <attr name="indicatorVisibility" />
        <attr name="indicatorOrientation" />
        <attr name="indicatorBackgroundColor" />>

        <attr name="bvp_page_style" format="enum">
            <enum name="normal" value="0" />
            <enum name="multi_page" value="2" />
            <enum name="multi_page_overlap" value="4" />
            <enum name="multi_page_scale" value="8" />
        </attr>


    </declare-styleable>
    <declare-styleable name="CustomWebView">
        <attr name="useJavascript" format="boolean|reference" />
    </declare-styleable>


    <attr name="orientation" format="dimension" />

    <!-- 垂直方向的虚线 -->
    <declare-styleable name="DividerView">
        <!-- 虚线朝向 -->
        <attr name="android:orientation" />
        <!-- 虚线颜色 -->
        <attr name="color" format="color|reference" />
        <!-- 虚线宽度 -->
        <attr name="length" format="dimension|reference" />
        <!-- 虚线dash宽度 -->
        <attr name="dash" format="dimension|reference" />
        <!-- 虚线dash间隔 -->
        <attr name="space" format="dimension|reference" />
        <attr name="line" format="enum">
            <enum name="fill" value="0" />
            <enum name="stroke" value="1" />
            <enum name="all" value="2" />
        </attr>
    </declare-styleable>

</resources>