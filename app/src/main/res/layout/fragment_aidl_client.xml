<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:src="@mipmap/banner1"
        app:layout_constraintDimensionRatio="1614:578"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/text"
        style="@style/Text.TabDefault"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/item_height"
        android:text="@string/aidl_client"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/image" />

    <Button
        android:id="@+id/status"
        style="@style/Theme.AndroidKotlin.Button"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/item_height"
        android:text="status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text" />

    <Button
        android:id="@+id/bind"
        style="@style/Theme.AndroidKotlin.Button"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/item_height"
        android:layout_marginTop="@dimen/margin_default"
        android:text="bind"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status" />

    <Button
        android:id="@+id/unbind"
        style="@style/Theme.AndroidKotlin.Button"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/item_height"
        android:layout_marginTop="@dimen/margin_default"
        android:text="unbind"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bind" />
</androidx.constraintlayout.widget.ConstraintLayout>