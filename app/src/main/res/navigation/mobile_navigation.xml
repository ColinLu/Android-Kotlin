<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/fragment_home">

    <fragment
        android:id="@+id/fragment_home"
        android:name="com.colin.android.demo.kotlin.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment" />

    <fragment
        android:id="@+id/fragment_gallery"
        android:name="com.colin.android.demo.kotlin.ui.gallery.GalleryFragment"
        android:label="@string/title_gallery"
        tools:layout="@layout/fragment" />
    <fragment
        android:id="@+id/fragment_view"
        android:name="com.colin.android.demo.kotlin.ui.view.ViewFragment"
        android:label="@string/title_view"
        tools:layout="@layout/fragment" />
    <fragment
        android:id="@+id/fragment_slideshow"
        android:name="com.colin.android.demo.kotlin.ui.slideshow.SlideshowFragment"
        android:label="@string/title_slideshow"
        tools:layout="@layout/fragment" />
    <fragment
        android:id="@+id/fragment_method"
        android:name="com.colin.android.demo.kotlin.ui.method.MethodFragment"
        android:label="@string/title_method"
        tools:layout="@layout/layout_refresh_list" />
    <fragment
        android:id="@+id/fragment_command"
        android:name="com.colin.android.demo.kotlin.ui.method.CommandFragment"
        android:label="@string/method_command"
        tools:layout="@layout/layout_refresh_list" />
    <fragment
        android:id="@+id/fragment_log"
        android:name="com.colin.android.demo.kotlin.ui.method.LogFragment"
        android:label="@string/method_log"
        tools:layout="@layout/layout_refresh_list" />

    <fragment
        android:id="@+id/fragment_gesture_image"
        android:name="com.colin.android.demo.kotlin.ui.view.GestureImageFragment"
        android:label="@string/view_image"
        tools:layout="@layout/fragment_gesture_image" />

    <fragment
        android:id="@+id/fragment_webIndex"
        android:name="com.colin.android.demo.kotlin.ui.web.WebIndexFragment"
        android:label="@string/view_web"
        tools:layout="@layout/layout_refresh_list" />

    <fragment
        android:id="@+id/fragment_web"
        android:name="com.colin.android.demo.kotlin.ui.web.WebViewFragment"
        android:label="@string/view_web"
        tools:layout="@layout/fragment_web_view">
        <argument
            android:name="type"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="url"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/fragment_list"
        android:name="com.colin.android.demo.kotlin.ui.list.ListFragment"
        android:label="@string/title_view"
        tools:layout="@layout/layout_refresh_list">
        <argument
            android:name="id"
            android:defaultValue="-1"
            app:argType="integer" />
        <argument
            android:name="title"
            android:defaultValue="title"
            app:argType="string" />
    </fragment>
    <action
        android:id="@+id/action_to_log"
        app:destination="@+id/fragment_log"
        app:enterAnim="@android:animator/fade_in"
        app:exitAnim="@android:animator/fade_out"
        app:popEnterAnim="@android:animator/fade_in"
        app:popExitAnim="@android:animator/fade_out"
        app:popUpTo="@+id/fragment_log" />
    <action
        android:id="@+id/action_webIndex"
        app:destination="@+id/fragment_webIndex" />
    <action
        android:id="@+id/action_web"
        app:destination="@+id/fragment_web" />
    <action
        android:id="@+id/action_list"
        app:destination="@+id/fragment_list" />
    <action
        android:id="@+id/action_command"
        app:destination="@+id/fragment_command" />

    <action
        android:id="@+id/action_gesture_image"
        app:destination="@+id/fragment_gesture_image" />
</navigation>